generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         Int               @id @default(autoincrement())
  email                      String            @unique
  password                   String?
  firstName                  String?           @map("first_name")
  lastName                   String?           @map("last_name")
  avatar                     String?
  role                       Role              @default(USER)
  isVerified                 Boolean           @default(false) @map("is_verified")
  googleId                   String?           @unique @map("google_id")
  lastLogin                  DateTime?         @map("last_login")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")
  emailVerificationExpiry    DateTime?         @map("email_verification_expiry")
  refreshToken               String?           @unique @map("refresh_token")
  emailVerificationOtp       String?           @map("email_verification_otp")
  passwordResetExpiry        DateTime?         @map("password_reset_expiry")
  passwordResetOtp           String?           @map("password_reset_otp")
  orderRequests              OrderRequest[]
  products                   Product[]
  referredUsers              Profile[]         @relation("ReferredByRelation")
  profile                    Profile?
  referralsReceived          Referral[]        @relation("RefereeRelation")
  referralsMade              Referral[]        @relation("ReferrerRelation")
  settlements                Settlement[]
  orderSettlementsAsReferrer OrderSettlement[] @relation("OrderReferrerSettlements")

  @@index([email])
  @@index([googleId])
  @@index([role])
  @@index([refreshToken])
  @@map("users")
}

model Profile {
  id             Int          @id @default(autoincrement())
  userId         Int          @unique @map("user_id")
  fullName       String?      @map("full_name")
  address        String?
  whatsappNumber String?      @map("whatsapp_number")
  bankAccount    BankAccount? @map("bank_account")
  accountNumber  String?      @map("account_number")
  facebookLink   String?      @map("facebook_link")
  dubizzleLink   String?      @map("dubizzle_link")
  verified       Boolean      @default(false)
  referralCode   String       @unique @map("referral_code")
  referredBy     Int?         @map("referred_by")
  listedProducts String[]     @default([]) @map("listed_products")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  referrer       User?        @relation("ReferredByRelation", fields: [referredBy], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([referralCode])
  @@index([verified])
  @@index([referredBy])
  @@map("profiles")
}

model Referral {
  id         Int      @id @default(autoincrement())
  referrerId Int      @map("referrer_id")
  refereeId  Int      @map("referee_id")
  createdAt  DateTime @default(now()) @map("created_at")
  referee    User     @relation("RefereeRelation", fields: [refereeId], references: [id], onDelete: Cascade)
  referrer   User     @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, refereeId])
  @@index([referrerId])
  @@index([refereeId])
  @@map("referrals")
}

model Product {
  id                    Int                   @id @default(autoincrement())
  ownerId               Int                   @map("owner_id")
  title                 String
  description           String?
  price                 Decimal               @db.Decimal(10, 2)
  categoryId            Int                   @map("category_id")
  condition             ProductCondition
  photos                String[]              @default([])
  brand                 String?
  colors                String[]              @default([])
  location              String?
  material              String?
  productTags           String[]              @default([]) @map("product_tags")
  quantity              Int                   @default(1)
  sku                   String?               @unique
  facebookPostingStatus FacebookPostingStatus @default(NOT_POSTED) @map("facebook_posting_status")
  facebookListingUrl    String?               @map("facebook_listing_url")
  facebookLastPosted    DateTime?             @map("facebook_last_posted")
  facebookRetryCount    Int                   @default(0) @map("facebook_retry_count")
  createdAt             DateTime              @default(now()) @map("created_at")
  category              Category              @relation(fields: [categoryId], references: [id])
  orderRequests         OrderRequest[]
  owner                 User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([categoryId])
  @@index([title])
  @@index([price])
  @@index([facebookPostingStatus])
  @@map("products")
}

model Category {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  products       Product[]
  customProducts CustomProduct[]

  @@map("categories")
}

model CustomProduct {
  id             Int          @id @default(autoincrement())
  orderRequestId Int          @map("order_request_id")
  name           String       @map("product_name")
  description    String?      @map("product_description")
  categoryId     Int          @map("category_id")
  images         String[]     @default([]) @map("customize_images")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  category       Category     @relation(fields: [categoryId], references: [id])
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)

  @@index([orderRequestId])
  @@index([categoryId])
  @@map("custom_products")
}

model OrderRequest {
  id               Int               @id @default(autoincrement())
  userId           Int               @map("user_id")
  productId        Int?              @map("product_id")
  isCustomProduct  Boolean           @default(false) @map("is_custom_product")
  platform         String?
  decidedPrice     Decimal           @db.Decimal(10, 2)
  advancePayment   Boolean           @default(false) @map("advance_payment")
  advancePay       Decimal?          @map("advance_pay") @db.Decimal(10, 2)
  customerName     String            @map("customer_name")
  customerPhone    String            @map("customer_phone")
  customerWhatsapp String            @map("customer_whatsapp")
  customerEmail    String            @map("customer_email")
  customerNotes    String?           @map("customer_notes")
  deliveryAddress  String?           @map("delivery_address")
  deliveryDate     DateTime?         @map("delivery_date")
  status           OrderStatus       @default(PENDING)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  customProducts   CustomProduct[]
  product          Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderSettlements OrderSettlement[]

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([isCustomProduct])
  @@index([createdAt])
  @@map("order_requests")
}

// When admin marks order as PARTIALLY_DELIVERED or DELIVERED, create settlement record
model OrderSettlement {
  id                     Int                   @id @default(autoincrement())
  orderRequestId         Int                   @map("order_request_id")
  totalAmount            Decimal               @map("total_amount") @db.Decimal(10, 2)
  productCost            Decimal               @map("product_cost") @db.Decimal(10, 2)
  adminCommission        Decimal               @map("admin_commission") @db.Decimal(10, 2)
  grossSellerAmount      Decimal               @map("gross_seller_amount") @db.Decimal(10, 2)
  referralCommission     Decimal?              @map("referral_commission") @db.Decimal(10, 2)
  referralCommissionRate Decimal?              @map("referral_commission_rate") @db.Decimal(5, 2)
  isFixedCommission      Boolean               @default(false) @map("is_fixed_commission")
  netSellerAmount        Decimal               @map("net_seller_amount") @db.Decimal(10, 2)
  referrerId             Int?                  @map("referrer_id")
  referrerRole           Role?                 @map("referrer_role")
  adminSettledBy         Int?                  @map("admin_settled_by")
  adminSettledAt         DateTime?             @map("admin_settled_at")
  referralSettledBy      Int?                  @map("referral_settled_by")
  referralSettledAt      DateTime?             @map("referral_settled_at")
  notes                  String?
  status                 OrderSettlementStatus @default(PENDING)
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  orderRequest           OrderRequest          @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  referrer               User?                 @relation("OrderReferrerSettlements", fields: [referrerId], references: [id])
  settlements            Settlement[]

  @@index([orderRequestId])
  @@index([referrerId])
  @@index([status])
  @@index([adminSettledAt])
  @@index([referralSettledAt])
  @@map("order_settlements")
}

// Individual settlement records for each party
model Settlement {
  id                Int              @id @default(autoincrement())
  orderSettlementId Int              @map("order_settlement_id")
  userId            Int              @map("user_id")
  settlementType    SettlementType   @map("settlement_type")
  amount            Decimal          @db.Decimal(10, 2)
  status            SettlementStatus @default(PENDING)
  paidAt            DateTime?        @map("paid_at")
  paymentProof      String?          @map("payment_proof")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  orderSettlement   OrderSettlement  @relation(fields: [orderSettlementId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderSettlementId])
  @@index([userId])
  @@index([settlementType])
  @@index([status])
  @@map("settlements")
}

// Track referral manager performance and activities
model ReferralManagerMetrics {
  id                    Int      @id @default(autoincrement())
  managerId             Int      @map("manager_id")
  totalReferrals        Int      @default(0) @map("total_referrals")
  activeReferrals       Int      @default(0) @map("active_referrals")
  totalOrders           Int      @default(0) @map("total_orders")
  totalRevenue          Decimal  @default(0) @map("total_revenue") @db.Decimal(10, 2)
  totalCommissionEarned Decimal  @default(0) @map("total_commission_earned") @db.Decimal(10, 2)
  pendingCommission     Decimal  @default(0) @map("pending_commission") @db.Decimal(10, 2)
  paidCommission        Decimal  @default(0) @map("paid_commission") @db.Decimal(10, 2)
  conversionRate        Decimal? @map("conversion_rate") @db.Decimal(5, 2)
  averageOrderValue     Decimal? @map("average_order_value") @db.Decimal(10, 2)
  lastActivityAt        DateTime @default(now()) @map("last_activity_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([managerId])
  @@index([managerId])
  @@index([totalRevenue])
  @@index([totalCommissionEarned])
  @@index([lastActivityAt])
  @@map("referral_manager_metrics")
}

// Track referral manager activities for audit trail
model ReferralManagerActivity {
  id           Int                         @id @default(autoincrement())
  managerId    Int                         @map("manager_id")
  activityType ReferralManagerActivityType @map("activity_type")
  description  String
  metadata     Json?
  ipAddress    String?                     @map("ip_address")
  createdAt    DateTime                    @default(now()) @map("created_at")

  @@index([managerId])
  @@index([activityType])
  @@index([createdAt])
  @@map("referral_manager_activities")
}

enum Role {
  USER
  ADMIN
  REFERRAL_MANAGER

  @@map("role")
}

enum BankAccount {
  EASYPAISA
  JAZZCASH
  BANK_ACCOUNT
  OTHER

  @@map("bank_account")
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  SECOND_HAND

  @@map("product_condition")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  DELIVERED
  CANCELLED
  PAYMENT_PENDING
  PARTIALLY_DELIVERED

  @@map("order_status")
}

enum FacebookPostingStatus {
  NOT_POSTED
  POSTING
  POSTED
  FAILED
  NEEDS_UPDATE

  @@map("facebook_posting_status")
}

enum SettlementStatus {
  PENDING
  PAID
  CANCELLED

  @@map("settlement_status")
}

enum OrderSettlementStatus {
  SETTLED
  MANAGER_PENDING
  PENDING
  CANCELLED

  @@map("order_settlement_status")
}

enum SettlementType {
  SELLER_PAYMENT
  REFERRAL_PAYMENT // Works for both USER and REFERRAL_MANAGER referrers
  ADMIN_COMMISSION

  @@map("settlement_type")
}

enum ReferralManagerActivityType {
  REFERRAL_CREATED
  REFERRAL_CONVERTED
  COMMISSION_EARNED
  COMMISSION_PAID
  PROFILE_UPDATED
  LOGIN
  LOGOUT

  @@map("referral_manager_activity_type")
}
