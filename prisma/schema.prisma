generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         Int               @id @default(autoincrement())
  email                      String            @unique
  password                   String?
  firstName                  String?           @map("first_name")
  lastName                   String?           @map("last_name")
  avatar                     String?
  role                       Role              @default(USER)
  isVerified                 Boolean           @default(false) @map("is_verified")
  googleId                   String?           @unique @map("google_id")
  lastLogin                  DateTime?         @map("last_login")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")
  emailVerificationExpiry    DateTime?         @map("email_verification_expiry")
  refreshToken               String?           @unique @map("refresh_token")
  emailVerificationOtp       String?           @map("email_verification_otp")
  passwordResetExpiry        DateTime?         @map("password_reset_expiry")
  passwordResetOtp           String?           @map("password_reset_otp")
  sentMessages               ChatMessage[]
  chatParticipants           ChatParticipant[]
  notifications              Notification[]
  orderRequests              OrderRequest[]
  orderSettlementsAsReferrer OrderSettlement[] @relation("OrderReferrerSettlements")
  products                   Product[]
  referredUsers              Profile[]         @relation("ReferredByRelation")
  profile                    Profile?
  referralsReceived          Referral[]        @relation("RefereeRelation")
  referralsMade              Referral[]        @relation("ReferrerRelation")
  settlements                Settlement[]
  factoryPaymentActions      FactoryPaymentHistory[]

  @@index([email])
  @@index([googleId])
  @@index([role])
  @@index([refreshToken])
  @@map("users")
}

model Profile {
  id             Int          @id @default(autoincrement())
  userId         Int          @unique @map("user_id")
  fullName       String?      @map("full_name")
  address        String?
  whatsappNumber String?      @map("whatsapp_number")
  bankAccount    BankAccount? @map("bank_account")
  accountNumber  String?      @map("account_number")
  bankName       String?      @map("bank_name")
  accountTitle   String?      @map("account_title")
  facebookLink   String?      @map("facebook_link")
  dubizzleLink   String?      @map("dubizzle_link")
  verified       Boolean      @default(false)
  referralCode   String       @unique @map("referral_code")
  referredBy     Int?         @map("referred_by")
  listedProducts String[]     @default([]) @map("listed_products")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  referrer       User?        @relation("ReferredByRelation", fields: [referredBy], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([referralCode])
  @@index([verified])
  @@index([referredBy])
  @@map("profiles")
}

model Referral {
  id         Int      @id @default(autoincrement())
  referrerId Int      @map("referrer_id")
  refereeId  Int      @map("referee_id")
  createdAt  DateTime @default(now()) @map("created_at")
  referee    User     @relation("RefereeRelation", fields: [refereeId], references: [id], onDelete: Cascade)
  referrer   User     @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, refereeId])
  @@index([referrerId])
  @@index([refereeId])
  @@map("referrals")
}

model Product {
  id            Int              @id @default(autoincrement())
  ownerId       Int              @map("owner_id")
  title         String
  description   String?
  price         Decimal          @db.Decimal(10, 2)
  condition     ProductCondition
  photos        String[]         @default([])
  brand         String?
  colors        String[]         @default([])
  location      String?
  material      String?
  productTags   String[]         @default([]) @map("product_tags")
  quantity      Int              @default(1)
  sku           String?          @unique
  createdAt     DateTime         @default(now()) @map("created_at")
  categoryId    Int              @map("category_id")
  orderRequests OrderRequest[]
  category      Category         @relation(fields: [categoryId], references: [id])
  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([categoryId])
  @@index([title])
  @@index([price])
  @@map("products")
}

model Category {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  customProducts CustomProduct[]
  products       Product[]

  @@map("categories")
}

model CustomProduct {
  id             Int          @id @default(autoincrement())
  orderRequestId Int          @map("order_request_id")
  name           String       @map("product_name")
  description    String?      @map("product_description")
  images         String[]     @default([]) @map("customize_images")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  categoryId     Int          @map("category_id")
  category       Category     @relation(fields: [categoryId], references: [id])
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)

  @@index([orderRequestId])
  @@index([categoryId])
  @@map("custom_products")
}

model OrderRequest {
  id               Int               @id @default(autoincrement())
  userId           Int               @map("user_id")
  productId        Int?              @map("product_id")
  platform         String?
  decidedPrice     Decimal           @db.Decimal(10, 2)
  advancePayment   Boolean           @default(false) @map("advance_payment")
  customerName     String            @map("customer_name")
  customerPhone    String            @map("customer_phone")
  customerWhatsapp String            @map("customer_whatsapp")
  customerEmail    String            @map("customer_email")
  deliveryAddress  String?           @map("delivery_address")
  deliveryDate     DateTime?         @map("delivery_date")
  status           OrderStatus       @default(PENDING)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  customerNotes    String?           @map("customer_notes")
  advancePay       Decimal?          @map("advance_pay") @db.Decimal(10, 2)
  isCustomProduct  Boolean           @default(false) @map("is_custom_product")
  customProducts   CustomProduct[]
  product          Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderSettlements OrderSettlement[]

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([isCustomProduct])
  @@index([createdAt])
  @@map("order_requests")
}

// Global factory payment tracking
model FactoryPayment {
  id        Int      @id @default(autoincrement())
  totalPaid Decimal  @default(0) @db.Decimal(10, 2) @map("total_paid")
  updatedAt DateTime @updatedAt @map("updated_at")

  history   FactoryPaymentHistory[]

  @@map("factory_payment")
}

model FactoryPaymentHistory {
  id               Int            @id @default(autoincrement())
  factoryPaymentId Int            @map("factory_payment_id")
  amount           Decimal        @db.Decimal(10, 2)
  adminId          Int            @map("admin_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  
  factoryPayment   FactoryPayment @relation(fields: [factoryPaymentId], references: [id], onDelete: Cascade)
  admin            User           @relation(fields: [adminId], references: [id])

  @@index([factoryPaymentId])
  @@index([adminId])
  @@map("factory_payment_history")
}

model OrderSettlement {
  id                     Int                   @id @default(autoincrement())
  orderRequestId         Int                   @map("order_request_id")
  totalAmount            Decimal               @map("total_amount") @db.Decimal(10, 2)
  productCost            Decimal               @map("product_cost") @db.Decimal(10, 2)
  adminCommission        Decimal               @map("admin_commission") @db.Decimal(10, 2)
  grossSellerAmount      Decimal               @map("gross_seller_amount") @db.Decimal(10, 2)
  referralCommission     Decimal?              @map("referral_commission") @db.Decimal(10, 2)
  referralCommissionRate Decimal?              @map("referral_commission_rate") @db.Decimal(5, 2)
  isFixedCommission      Boolean               @default(false) @map("is_fixed_commission")
  netSellerAmount        Decimal               @map("net_seller_amount") @db.Decimal(10, 2)
  referrerId             Int?                  @map("referrer_id")
  referrerRole           Role?                 @map("referrer_role")
  adminSettledBy         Int?                  @map("admin_settled_by")
  adminSettledAt         DateTime?             @map("admin_settled_at")
  referralSettledBy      Int?                  @map("referral_settled_by")
  referralSettledAt      DateTime?             @map("referral_settled_at")
  notes                  String?
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  status                 OrderSettlementStatus @default(PENDING)
  orderRequest           OrderRequest          @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  referrer               User?                 @relation("OrderReferrerSettlements", fields: [referrerId], references: [id])
  settlements            Settlement[]

  @@index([orderRequestId])
  @@index([referrerId])
  @@index([status])
  @@index([adminSettledAt])
  @@index([referralSettledAt])
  @@map("order_settlements")
}

model Settlement {
  id                Int              @id @default(autoincrement())
  orderSettlementId Int              @map("order_settlement_id")
  userId            Int              @map("user_id")
  settlementType    SettlementType   @map("settlement_type")
  amount            Decimal          @db.Decimal(10, 2)
  status            SettlementStatus @default(PENDING)
  paidAt            DateTime?        @map("paid_at")
  paymentProof      String?          @map("payment_proof")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  orderSettlement   OrderSettlement  @relation(fields: [orderSettlementId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderSettlementId])
  @@index([userId])
  @@index([settlementType])
  @@index([status])
  @@map("settlements")
}

model ChatRoom {
  id            Int               @id @default(autoincrement())
  type          ChatRoomType      @default(DIRECT)
  referralId    Int?              @map("referral_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  lastMessageAt DateTime?         @map("last_message_at")
  messages      ChatMessage[]
  participants  ChatParticipant[]

  @@index([type])
  @@index([lastMessageAt])
  @@index([referralId])
  @@map("chat_rooms")
}

model ChatParticipant {
  id          Int       @id @default(autoincrement())
  chatRoomId  Int       @map("chat_room_id")
  userId      Int       @map("user_id")
  unreadCount Int       @default(0) @map("unread_count")
  lastReadAt  DateTime? @map("last_read_at")
  isArchived  Boolean   @default(false) @map("is_archived")
  isMuted     Boolean   @default(false) @map("is_muted")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  chatRoom    ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
  @@index([userId])
  @@index([chatRoomId])
  @@index([unreadCount])
  @@index([isArchived])
  @@map("chat_participants")
}

model ChatMessage {
  id          Int           @id @default(autoincrement())
  chatRoomId  Int           @map("chat_room_id")
  senderId    Int           @map("sender_id")
  content     String?
  messageType MessageType   @default(TEXT)
  fileUrl     String?       @map("file_url")
  fileName    String?       @map("file_name")
  fileSize    Int?          @map("file_size")
  mimeType    String?       @map("mime_type")
  duration    Int?          @map("duration")
  status      MessageStatus @default(SENT)
  isEdited    Boolean       @default(false) @map("is_edited")
  isDeleted   Boolean       @default(false) @map("is_deleted")
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  chatRoom    ChatRoom      @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatRoomId, createdAt])
  @@index([senderId])
  @@index([status])
  @@index([isDeleted])
  @@map("chat_messages")
}

model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false) @map("is_read")
  actionUrl   String?          @map("action_url")
  referenceId Int?             @map("reference_id")
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  readAt      DateTime?        @map("read_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
  @@map("notifications")
}

model Announcement {
  id         Int                  @id @default(autoincrement())
  adminId    Int                  @map("admin_id")
  title      String
  message    String
  priority   AnnouncementPriority @default(NORMAL)
  targetRole Role?                @map("target_role")
  isActive   Boolean              @default(true) @map("is_active")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  expiresAt  DateTime?            @map("expires_at")

  @@index([adminId])
  @@index([priority])
  @@index([isActive])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("announcements")
}

enum Role {
  USER
  ADMIN
  REFERRAL_MANAGER

  @@map("role")
}

enum BankAccount {
  EASYPAISA
  JAZZCASH
  BANK_ACCOUNT
  OTHER

  @@map("bank_account")
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  SECOND_HAND

  @@map("product_condition")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  DELIVERED
  CANCELLED
  PAYMENT_PENDING
  PARTIALLY_DELIVERED

  @@map("order_status")
}

enum SettlementStatus {
  PENDING
  PAID
  CANCELLED

  @@map("settlement_status")
}

enum OrderSettlementStatus {
  SETTLED
  MANAGER_PENDING
  PENDING
  CANCELLED

  @@map("order_settlement_status")
}

enum SettlementType {
  SELLER_PAYMENT
  REFERRAL_PAYMENT
  ADMIN_COMMISSION

  @@map("settlement_type")
}

enum ChatRoomType {
  DIRECT
  ADMIN_SUPPORT
  MANAGER_SUPPORT

  @@map("chat_room_type")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  VOICE_NOTE
  FILE

  @@map("message_type")
}

enum MessageStatus {
  SENT
  DELIVERED
  READ

  @@map("message_status")
}

enum NotificationType {
  NEW_MESSAGE
  ORDER_UPDATE
  SETTLEMENT_UPDATE
  SYSTEM
  REFERRAL
  PRODUCT
  ANNOUNCEMENT

  @@map("notification_type")
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("announcement_priority")
}
